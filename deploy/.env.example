# Copy to .env (install.sh does this and fills in random secrets).

# Application image version from the release bundle.
DTAT_VERSION=0.1.0

# Database password and JWT signing key: long random strings.
POSTGRES_PASSWORD=
DTAT_SECRET_KEY=

# First administrator, created on the first start if there are no users yet.
# Change the password after the first login and clear it here.
DTAT_INITIAL_ADMIN_USERNAME=admin
DTAT_INITIAL_ADMIN_PASSWORD=

# Session cookie only over HTTPS. Set to false only for a plain-HTTP test setup.
DTAT_COOKIE_SECURE=true

# Host ports.
DTAT_HTTP_PORT=80
DTAT_HTTPS_PORT=443
