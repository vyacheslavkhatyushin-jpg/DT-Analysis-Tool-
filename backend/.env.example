# Local development settings: copy to backend/.env
DTAT_DATABASE_URL=postgresql+psycopg://dtat:dtat@localhost:5432/dtat
DTAT_SECRET_KEY=dev-secret-key-change-me-0123456789
# The dev server runs on plain HTTP.
DTAT_COOKIE_SECURE=false
# Serve .pmtiles basemaps from ../tiles without nginx.
DTAT_SERVE_TILES=true
DTAT_TILES_DIR=../tiles
